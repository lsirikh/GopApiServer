# Authentication
# v5.4 (2026-07-03): 기본값 public → token (Bearer 필수 + matrix_enforcer 활성).
#   User/Admin 2계층 인가 강화 발효 — ADMIN=SuperUser, USER=UserGroupGrant 그룹 permissions 게이팅.
AUTH_MODE=token
JWT_SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# PostgreSQL
POSTGRES_DB=gop
POSTGRES_USER=gop_user
POSTGRES_PASSWORD=gop_pass

# Database URL (api_server → postgres container)
API_DATABASE_URL=postgresql://gop_user:gop_pass@postgres:5432/gop

# Database URL (db_monitor → postgres container)
MONITOR_DATABASE_URL=postgresql://gop_user:gop_pass@postgres:5432/gop

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
INIT_SAMPLE_DATA=true

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["*"]

# DB Change Monitor
NATS_URL=nats://localhost:4222
UNIT_ID=unit001

# ─────────────────────────────────────────────────────────────────────────────
# Force-Logout NATS revoke publisher (v5.2 FR-SVF-05/08)
#
# NATS_REVOKE_ENABLED
#   ★ 기본 False (미발행). force_logout 은 DB 블랙리스트만 수행하고, NATS 는 조용.
#   True 로 플립 = per-session subject 로 revoke 이벤트 실발행.
#   subject : sensorway.{UNIT_ID}.account.{user_id}.session.{sid}.revoke
#             (광역 all.> 금지, 서명 HMAC-SHA256 with REVOKE_SIGNING_KEY)
#
#   ▷ 활성화 전 3 게이트 (모두 통과 후 True 로) :
#     [B-1] 클라이언트 subject 구독 준비 완료 확인
#           - .NET GIS / Ironwall / RtspViewer 3 클라가
#             sensorway.{unit}.account.{user_id}.session.{sid}.revoke 구독 실장 + 콘솔 로그 확인
#     [B-2] NATS ACL 화이트리스트 반영
#           - 서버 계정만 account.>.session.>.revoke publish 허용
#           - 클라 계정은 subscribe-only (publish 금지)
#     [B-3] 서버 배포
#           - .env NATS_REVOKE_ENABLED=true + REVOKE_SIGNING_KEY 운영값 교체
#           - api-server 재기동 후 force_logout 1건 실발행 → 클라 콘솔 확인
#
#   ▷ 롤백 : NATS_REVOKE_ENABLED=false 로 원복 + api-server 재기동.
#            DB 블랙리스트 경로는 게이트와 무관하게 항상 동작하므로 안전.
#
#   상세 절차 : docs/GOP_ForceLogout_Activation_Guide.md
# ─────────────────────────────────────────────────────────────────────────────
NATS_REVOKE_ENABLED=false
# REVOKE_SIGNING_KEY 는 JWT_SECRET_KEY 와 반드시 분리. 운영 배포 시 랜덤 값으로 교체.
# 생성 예: python -c "import os; print(os.urandom(32).hex())"
REVOKE_SIGNING_KEY=dev-revoke-signing-key-change-in-production
