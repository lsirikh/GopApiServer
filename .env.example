# Authentication
# v5.4 (2026-07-03): 기본값 public → token (Bearer 필수 + matrix_enforcer 활성).
#   User/Admin 2계층 인가 강화 발효 — ADMIN=SuperUser, USER=UserGroupGrant 그룹 permissions 게이팅.
AUTH_MODE=token
JWT_SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# PostgreSQL
POSTGRES_DB=gop
POSTGRES_USER=gop_user
POSTGRES_PASSWORD=gop_pass

# Database URL (api_server → postgres container)
API_DATABASE_URL=postgresql://gop_user:gop_pass@postgres:5432/gop

# Database URL (db_monitor → postgres container)
MONITOR_DATABASE_URL=postgresql://gop_user:gop_pass@postgres:5432/gop

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
INIT_SAMPLE_DATA=true

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["*"]

# DB Change Monitor
NATS_URL=nats://localhost:4222
UNIT_ID=unit001
